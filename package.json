  "dependencies": {
    "@hocuspocus/provider": "4.7.0",
    "@hocuspocus/server": "4.7.0",
    "better-auth": "^1.7.6",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "fractional-indexing": "^4.0.0",
    "helmet": "^8.2.0",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.12",
    "overmind": "^28.2.1",
    "overmind-react": "^29.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^11.1.1",
    "ws": "^8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:webpack",
    "build:webpack": "cross-env NODE_ENV=production node ./node_modules/webpack/bin/webpack --config webpack.config.mjs",
    "clean": "rimraf dist",
    "lint": "eslint src tests server *.ts *.mjs *.mts scripts --max-warnings 0",
    "rebuild": "pnpm run build:webpack",
    "serve": "cross-env NODE_ENV=production node server.prod.ts",
    "start": "node server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "tsc --noEmit",
    "webpack": "node ./node_modules/webpack/bin/webpack",
    "lint:fix": "eslint src tests server *.ts *.mjs *.mts scripts --max-warnings 0 --fix",
    "lint:baseline": "node scripts/check-lint-baseline.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "pnpm run tsc && tsc -p tsconfig.test.json && tsc -p tsconfig.server.json",
    "test:browser": "playwright test",
    "check": "pnpm run lint:baseline && pnpm run lint:css && pnpm run typecheck && pnpm test && pnpm run test:browser"
  }
}
